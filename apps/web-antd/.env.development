# 端口号（DramaFlow 约定：admin dev 6002）
VITE_PORT=6002

VITE_BASE=/

# 接口地址（DramaFlow API 6000；后端 admin 路由带 admin/ 前缀，见契约 §5.0）
VITE_GLOB_API_URL=http://localhost:6000/admin

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
